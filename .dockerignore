dsm_client/frontend/dist/
dsm_client/frontend/build/
dsm_client/deterministic_state_machine/target/
**/jniLibs/
**/*.so
**/*.apk
**/*.aab
dsm_storage_node/deploy/nodes/
dsm_storage_node/deploy/*.tar
dsm_storage_node/dev-pki/
dsm_storage_node/logs/
