import Statement.VaultStep

/-!
# Research build: the `BLAKE3` instruction's vectors, from the Rust

Generated by `write_lean_blake3_vectors` (`crates/stable_prover/lean_vm_core/src/blake3flock.rs`); not edited. Compressions of the cells a `BLAKE3` reads, as the executor computes them (`compression`, `output`): a one-block hash with no placed input (the IV, counter 0, length 64, flags `CHUNK_START | CHUNK_END | ROOT`), one with only the placed inputs, and random cells. Each `#guard` checks `Blake3CellsRelation` and the output cells against them, as limbs. A plain file, not a module, so the guards may run what it imports.
-/

namespace LeanVM.Semantics.Blake3.Vectors

open LeanVM.Parameters LeanVM.Semantics LeanVM.Vault

/-- A hex string's bytes. -/
def hexBytes (s : String) : List UInt8 :=
  let d := fun (c : Char) ↦ if c.isDigit then c.toNat - 48 else c.toNat - 87
  let cs := s.toList
  (List.range (cs.length / 2)).map fun i ↦ (16 * d (cs.getD (2 * i) '0') + d (cs.getD (2 * i + 1) '0')).toUInt8

/-- Cell `c` of cells written as their limbs' little-endian bytes, 16 per cell. -/
def cellAt (s : String) (c : ℕ) : E := cell16 ((hexBytes s).drop (16 * c))

/-- A cell's two limbs, which `K`'s equality compares. -/
def limbs (x : E) : K × K := (x.limb 0, x.limb 1)

def input0 : Fin 13 → E := fun c ↦ cellAt "" c.val
def output0 : Fin 13 → E := fun c ↦ cellAt "4e0c6e5d624a9af4d9491886cb5c0f6fb673ad6981fa3d0e2f6a095701ba1152" c.val
#guard limbs (chainCell (compressCells input0) 0) == limbs (output0 0)
#guard limbs (chainCell (compressCells input0) 1) == limbs (output0 1)
#guard decide (Blake3CellsRelation input0 output0)
#guard !decide (Blake3CellsRelation input0 (fun c ↦ if c = 1 then output0 0 else output0 c))

#guard blake3 ((hexBytes "f465b9a16a9e786e4f450980185dc406ec814c72a8b88bf89b74a8516a89391beaa27e740c9fcb53e132451fbe9a822c3cab16c93a1384c5c38ac9419078e53e")) == wordBytes (compressCells input0).toList

