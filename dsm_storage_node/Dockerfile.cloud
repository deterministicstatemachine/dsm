# DSM Storage Node — Cloud Production Dockerfile
# Multi-stage build for AWS EC2 deployment with PostgreSQL
#
# Build from the workspace root:
#   docker build -f dsm_storage_node/Dockerfile.cloud -t dsm-storage-node:latest .
#
# Run:
#   docker run --rm -p 8080:8080 -v ./config:/config:ro -v ./certs:/certs:ro \
#       dsm-storage-node:latest --config /config/node.toml

# ---------------------------------------------------------------------------
# Stage 1: Rust builder (compile storage_node binary)
# ---------------------------------------------------------------------------
FROM rust:1.98-slim-bookworm AS builder

# python3 runs the real-code guard (scripts/real_code_guard.py), which every
# crate's build script runs; protobuf-compiler serves the proto build scripts.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# The whole workspace, as ci/docker/StorageNode.Dockerfile builds it
# (.dockerignore keeps out target/, node_modules/ and .git/): every member
# manifest is the real one, and the guard finds its script, its baseline and
# the files its wiring check reads.
COPY . .

# Build the binary (PostgreSQL mode — default features)
ENV DSM_PROTO_ROOT=/build/proto
RUN cargo build --release --locked --package dsm_storage_node

# ---------------------------------------------------------------------------
# Stage 2: Minimal runtime image
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN groupadd -r dsm && useradd -r -g dsm -d /app dsm

# Copy binary
COPY --from=builder /build/target/release/storage_node /usr/local/bin/storage_node
RUN chmod 555 /usr/local/bin/storage_node

# Create directories for config and certs (mounted at runtime)
RUN mkdir -p /config /certs /data && chown -R dsm:dsm /config /certs /data

WORKDIR /app
USER dsm

# Health check via HTTPS (production runs TLS; --insecure for self-signed cert)
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -sf --insecure https://localhost:8080/api/v2/health || exit 1

EXPOSE 8080 9090

ENTRYPOINT ["/usr/local/bin/storage_node"]
CMD ["--config", "/config/node.toml"]
