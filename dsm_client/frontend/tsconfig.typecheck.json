{
  // `npm run type-check` covers the SOURCE TREE. It used to name a dozen files,
  // so it passed while real type errors sat in the code it never opened — among
  // them a Mail screen sending a field its API does not take.
  //
  // Only generated protobuf output is left out: it is not hand-written, and the
  // legacy pair below predates the current generator.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "src/proto/dsm_app.ts",
    "src/proto/google/protobuf/**"
  ]
}
