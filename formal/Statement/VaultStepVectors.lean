namespace LeanVM.Vault.Vectors

open LeanVM.Parameters

/-- A hex string's bytes. -/
def hexBytes (s : String) : List UInt8 :=
  let d := fun (c : Char) ↦ if c.isDigit then c.toNat - 48 else c.toNat - 87
  let cs := s.toList
  (List.range (cs.length / 2)).map fun i ↦ (16 * d (cs.getD (2 * i) '0') + d (cs.getD (2 * i + 1) '0')).toUInt8

/-- A byte string's 32-byte pieces. -/
def chunks32 (b : List UInt8) : List (List UInt8) :=
  (List.range (b.length / 32)).map fun i ↦ (b.drop (32 * i)).take 32

/-- A cell's two limbs, which `K`'s equality compares. -/
def limbs (x : E) : K × K := (x.limb 0, x.limb 1)

/-- Cells written as their limbs' little-endian bytes, 16 per cell. -/
def hexCells (s : String) : List (K × K) :=
  let b := hexBytes s
  (List.range (b.length / 16)).map fun i ↦ limbs (cell16 (b.drop (16 * i)))

/-- Pushes as limbs, for comparison. -/
def asLimbs (p : List (String × List E)) : List (String × List (K × K)) :=
  p.map fun e ↦ (e.1, e.2.map limbs)

