#!/usr/bin/env bash
# .githooks/pre-push
# Slower checks that run before push (~30–60s).
# Install once with: bash scripts/install-hooks.sh
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; exit 1; }
info() { echo -e "${YELLOW}▶${NC} $1"; }

echo ""
echo "┌─────────────────────────────────────────┐"
echo "│           DSM pre-push checks           │"
echo "└─────────────────────────────────────────┘"
echo ""

# ---------------------------------------------------------------------------
# 1. Lint
# ---------------------------------------------------------------------------
info "Running make lint..."
if ! make lint 2>&1; then
  fail "make lint failed — fix lint issues before pushing"
fi
pass "make lint"

# ---------------------------------------------------------------------------
# 2. Production safety checks
#
# The board (every test, --release, serial) runs in CI on the pushed commit;
# it takes longer than a push hook can. What runs here is the set of gates
# that read the tree: the same ones CI runs before the board.
# ---------------------------------------------------------------------------
info "Running production safety checks..."
if ! bash ci/production_safety_checks.sh 2>&1; then
  fail "production safety checks failed — fix them before pushing"
fi
pass "production safety checks"

# ---------------------------------------------------------------------------
# 3. Codegen enforcement
# ---------------------------------------------------------------------------
info "Checking codegen enforcement..."
bash scripts/codegen_enforce.sh
pass "Codegen enforcement"

info "Checking proto guards..."
bash scripts/guard_protos.sh
pass "Proto guards"

echo ""
echo -e "${GREEN}All pre-push checks passed.${NC}"
echo ""
